+/// The `merge` door reading `src` raises, its targets those not yet reached (`keep`).
+pub fn merge_clue(g: &mut Graph, src: &str, keep: impl Fn(&str) -> bool) -> Result<Option<Clue>> {
+    let Some((m, tg)) = g.merge_door(src)? else { return Ok(None) };
+    let mut tg: Vec<String> = tg.into_iter().filter(|d| d != src && keep(d)).collect();
+    tg.sort();
+    tg.dedup();
+    Ok((!tg.is_empty()).then(|| Clue { key: format!("merge:{m}"), kind: "merge".into(), x: m, source: src.to_string(), targets: tg, wave: 0, p: None }))
 }
 
