+/// A merge commit's branch: from `git log --format='%H %P'` (newest first, HEAD first), each merge's second parent
+/// and its first-parent ancestors until the first commit on HEAD's first-parent line, at most `MERGE_MAX`.
+fn merged_by(log: &str) -> HashMap<String, Vec<String>> {
+    const MERGE_MAX: usize = 50;
+    let parents: HashMap<&str, Vec<&str>> = log.lines().filter_map(|l| {
+        let mut it = l.split_whitespace();
+        it.next().map(|h| (h, it.collect()))
+    }).collect();
+    let mut main: HashSet<&str> = HashSet::new();
+    let mut at = log.lines().next().and_then(|l| l.split_whitespace().next());
+    while let Some(h) = at {
+        if !main.insert(h) {
+            break;
+        }
+        at = parents.get(h).and_then(|p| p.first().copied());
+    }
+    let mut out = HashMap::new();
+    for (m, ps) in &parents {
+        let Some(mut c) = ps.get(1).copied() else { continue };
+        let mut v = vec![];
+        while !main.contains(c) && v.len() < MERGE_MAX {
+            v.push(c.to_string());
+            match parents.get(c).and_then(|p| p.first()) {
+                Some(p) => c = p,
+                None => break,
+            }
+        }
+        if !v.is_empty() && std::env::var("AVALANCHE_DEV_MERGES").as_deref() == Ok("1") {
+            out.insert(m.to_string(), v);
+        }
+    }
+    out
+}
